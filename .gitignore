node_modules
dist
.aws-sam
.DS_Store
*.log
.vite

# RapidAPI key for fetch-data (never commit)
scripts/.pokemon-api-key
*.pokemon-api-key
.playwright-mcp

# Local env — NEVER COMMIT. This repo is PUBLIC, and Vite INLINES import.meta.env.* into the
# built bundle, so anything here would ship in the JavaScript rather than stay server-side.
.env
.env.*
!.env.example

# iOS — the Xcode project is GENERATED from ios/project.yml by `npm run ios:project`.
# Committing it means two sources of truth and a merge conflict every time either moves.
ios/*.xcodeproj
ios/build
ios/DerivedData
# SwiftPM scratch for the local packages (`npm run swift:test` builds them on the Mac).
ios/Packages/*/.build
ios/Packages/*/.swiftpm
ios/Packages/*/Package.resolved
# Generated by `npm run catalog:compile` from src/data/sets.json. The manifest next to them
# (catalog.manifest.json) IS committed — it is the vanished-set guard.
ios/Packages/PVCatalog/Sources/PVCatalog/Resources/catalog.pvc
ios/Packages/PVCatalog/Tests/PVCatalogTests/engine-indexes.json

# Mobile sweep output — screenshots + report, regenerated by `npm run sweep`
tools/ios/sweep-out
# Cross-engine differ output — the script, both reports, the golden saves (`npm run differ`)
tools/differ/out
__pycache__/
