# Copy to .env.shell.local to enable auto sign-in in the personal iOS build.
#
#   cp .env.example .env.shell.local     # then fill it in
#   npm run ios:device
#
# .env.shell.local is loaded ONLY by `vite build --mode shell` (which is what ios:build runs).
# `npm run build` — the GitHub Pages deploy, from a PUBLIC repo — runs in production mode and
# never reads it, so these cannot leak into the published site.
#
# They ARE inlined into the .ipa on the phone. Anyone with that build has the account.
VITE_AUTO_LOGIN_EMAIL=
VITE_AUTO_LOGIN_PASSWORD=
